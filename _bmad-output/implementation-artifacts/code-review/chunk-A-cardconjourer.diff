+        for j in jobs:
+            slot = j["slot"]
+            name = j["name"]
+            png = outdir / f"{slot}-{name.lower().replace(' ', '_')}.png"
+            png.write_bytes(b"NEW")
+            responses.append({"slot": slot, "status": "ok", "out": str(png), "ms": 5})
+        return responses
