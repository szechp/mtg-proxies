+def test_render_deck_writes_pngs_fallback_and_report(tmp_path: Path) -> None:
+    """End-to-end pure-python: jobs out, responses in, files on disk."""
+    from mtg_proxies.cardconjourer.runner import render_deck
+
+    cards = [
+        (1, "Murder"),
+        (1, "Urza's Saga"),
